---
interface Props { head?: string[]; rows: (string | number)[][]; caption?: string }
const { head, rows, caption } = Astro.props;
---
<div class="table-scroll">
  <table>
    {caption && <caption>{caption}</caption>}
    {head && (
      <thead><tr>{head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
    )}
    <tbody>
      {rows.map((r) => (
        <tr>{r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  caption { text-align: left; font-size: var(--step--1); color: var(--ink-muted); padding-bottom: var(--space-2xs); }
</style>
