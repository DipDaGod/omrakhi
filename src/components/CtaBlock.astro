---
import { useTranslations, type Locale } from '../i18n/ui.ts';
import { telHref, whatsappHref } from '../lib/whatsapp.ts';
import { SITE } from '../config/site.ts';
import Icon from './Icon.astro';

interface Props { locale: Locale; title: string; body?: string; context?: string }
const { locale, title, body, context } = Astro.props;
const t = useTranslations(locale);
---
<aside class="cta">
  <div class="cta__text">
    <h2 class="cta__title">{title}</h2>
    {body && <p>{body}</p>}
  </div>
  <div class="cta__actions">
    <a class="btn btn--primary" href={whatsappHref(context)} rel="noopener">
      <Icon name="whatsapp" /> {t('action.whatsappUs')}
    </a>
    <a class="btn btn--secondary" href={telHref}>
      <Icon name="phone" /> {SITE.phone.display}
    </a>
  </div>
</aside>
<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding: var(--space-l);
    background: var(--plinth);
  }
  .cta__text { max-width: var(--measure); }
  .cta__title { font-size: var(--step-2); margin-bottom: var(--space-3xs); }
  .cta__actions { display: flex; gap: var(--space-2xs); flex-wrap: wrap; }
</style>
