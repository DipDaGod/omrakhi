---
import { SITE } from '../config/site.ts';
import { useTranslations, type Locale } from '../i18n/ui.ts';
import { telHref, whatsappHref, isOpenNow } from '../lib/whatsapp.ts';
import { openCloseForNow, hoursForNow } from '../lib/season.ts';
import Icon from './Icon.astro';

/**
 * A3 — the floating contact dock.
 *
 * The WhatsApp deep link carries a message built from the page it was tapped
 * on, because the single biggest friction in a B2B enquiry is the buyer having
 * to explain what he is looking at.
 */
interface Props { locale: Locale; context?: string }
const { locale, context } = Astro.props;
const t = useTranslations(locale);
const message = context
  ? `${SITE.name} — ${context}`
  : `${SITE.name} — ${t('dock.enquiry')}`;
const open = isOpenNow();
const hours = openCloseForNow();
/* The out-of-hours line names the time the shop opens, so it has to come from
   the season's hours rather than being written into the string. */
const opensAt = hoursForNow().find((h) => h.open)?.open ?? '';
const shutLabel = t('dock.outOfHours').replace('{time}', opensAt);
---
<div class="dock" data-dock data-open={open ? '' : undefined}>
  <a class="dock__wa btn btn--primary" href={whatsappHref(message)} rel="noopener">
    <Icon name="whatsapp" />
    <span class="dock__label" data-dock-label>
      {open ? t('action.whatsappUs') : shutLabel}
    </span>
  </a>
  <a class="dock__call btn btn--secondary" href={telHref} aria-label={`${t('action.call')} ${SITE.phone.display}`}>
    <Icon name="phone" />
    <span class="dock__calltext">{t('action.call')}</span>
  </a>
</div>

<style>
  .dock {
    position: fixed;
    right: var(--space-m);
    bottom: var(--space-m);
    z-index: var(--z-dock);
    display: flex;
    gap: var(--space-2xs);
    box-shadow: var(--shadow-float);
  }
  .dock .btn { border-radius: var(--radius); }
  @media (max-width: 40rem) {
    .dock {
      right: 0;
      left: 0;
      bottom: 0;
      gap: 0;
      box-shadow: var(--shadow-float);
    }
    .dock .btn { flex: 1; justify-content: center; padding-block: 0.8em; }
    .dock__call { flex: 0 0 35%; }
    .dock__label { font-size: var(--step--1); }
  }
</style>

<script is:inline define:vars={{ openLabel: t('action.whatsappUs'), shutLabel, hours }}>
  (function () {
    // Rendered at build time, corrected in the visitor's present: a buyer at
    // 11pm should not conclude he is being ignored. The hours come from the
    // same seasonal table the footer prints, so the two cannot disagree.
    var label = document.querySelector('[data-dock-label]');
    var dock = document.querySelector('[data-dock]');
    if (!label) return;
    function tick() {
      var ist = new Date(Date.now() + (5 * 60 + 30) * 60000);
      var h = ist.getUTCHours() + ist.getUTCMinutes() / 60;
      var shut = hours.closedWeekdays.indexOf(ist.getUTCDay()) !== -1;
      var openNow = !shut && h >= hours.openHour && h < hours.closeHour;
      label.textContent = openNow ? openLabel : shutLabel;
      if (dock) dock.toggleAttribute('data-open', openNow);
      var status = document.querySelectorAll('[data-hours-status]');
      for (var i = 0; i < status.length; i++) {
        var el = status[i];
        el.textContent = openNow ? el.dataset.open : el.dataset.closed;
        el.classList.toggle('is-open', openNow);
      }
    }
    tick();
    // A tab left open across closing time should not keep saying "open".
    setInterval(tick, 60000);
  })();
</script>
