---
import Icon from './Icon.astro';
/** Every download shows size, format and date before the link. A 40MB
    unlabelled download on mobile data is a hostile act. */
interface Props {
  title: string;
  meta: string;
  href?: string | null;
  unavailable?: string;
}
const { title, meta, href, unavailable } = Astro.props;
---
<div class="dl">
  <Icon name="pdf" size={24} />
  <div class="dl__text">
    <span class="dl__title">{title}</span>
    <span class="dl__meta">{meta}</span>
  </div>
  {href
    ? <a class="btn btn--secondary" href={href} download><Icon name="download" /> PDF</a>
    : <span class="dl__pending">{unavailable}</span>}
</div>
<style>
  .dl {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-s) 0;
    border-bottom: var(--hairline) solid var(--line);
  }
  .dl__text { flex: 1; display: grid; gap: 0.1em; }
  .dl__title { font-weight: 600; }
  .dl__meta { font-size: var(--step--1); color: var(--ink-muted); }
  .dl__pending { font-size: var(--step--1); color: var(--warn); text-align: right; }
</style>
