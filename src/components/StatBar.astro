---
/**
 * P1 §3 — real numbers only, and no animated count-ups: they delay the number,
 * they are a generated-page cliché, and they break for reduced-motion users.
 */
interface Props { stats: { value: string; label: string }[] }
const { stats } = Astro.props;
---
<ul class="stats">
  {stats.map((s) => (
    <li>
      <span class="stats__value">{s.value}</span>
      <span class="stats__label">{s.label}</span>
    </li>
  ))}
</ul>
<style>
  /* Flex rather than an auto-fit grid: any number set to null in PROOF is
     omitted, and two remaining stats should sit together at their natural
     width rather than each stretching across half the page. */
  .stats {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-2xl);
    border-block: var(--hairline) solid var(--line);
    padding-block: var(--space-m);
  }
  .stats li { display: grid; gap: var(--space-3xs); min-width: 8rem; }
  .stats__value { font-family: var(--font-display); font-size: var(--step-3); line-height: 1; }
  .stats__label { font-size: var(--step--1); color: var(--ink-muted); }
  @media (max-width: 40rem) { .stats { gap: var(--space-m) var(--space-xl); } .stats li { min-width: 40%; } }
</style>
