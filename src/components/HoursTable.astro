---
import { useTranslations, type Locale } from '../i18n/ui.ts';
import { hoursForNow, currentPhase } from '../lib/season.ts';

/** Hours as a table with the current day highlighted client-side, so a static
    page can still tell a visitor what today looks like. */
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const rows = hoursForNow();
const phase = currentPhase();
const closedLabel = locale === 'hi' ? 'बंद' : 'Closed';
const note =
  phase === 'development'
    ? locale === 'hi' ? 'ऑफ़ सीज़न का समय (सितंबर–नवंबर)' : 'Off-season hours (September – November)'
    : locale === 'hi' ? 'सीज़न का समय (दिसंबर–अगस्त)' : 'Season hours (December – August)';
---
<div class="hours">
  <table data-hours>
    <caption class="visually-hidden">{t('label.hours')}</caption>
    <tbody>
      {rows.map((r) => (
        <tr data-days={r.days}>
          <th scope="row">{r.days}</th>
          <td>{r.open ? `${r.open} – ${r.close}` : closedLabel}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="hours__note">{note}</p>
</div>
<style>
  .hours table { max-width: 24rem; }
  .hours :global(tr[data-today]) { background: var(--plinth); }
  .hours :global(tr[data-today]) th::after { content: ' ·'; color: var(--accent); }
  .hours__note { font-size: var(--step--1); color: var(--ink-muted); margin-top: var(--space-2xs); }
</style>
<script is:inline>
  (function () {
    var t = document.querySelector('[data-hours]');
    if (!t) return;
    // IST has no daylight saving, so this is exact wherever the visitor is.
    var ist = new Date(Date.now() + (5 * 60 + 30) * 60000);
    var sunday = ist.getUTCDay() === 0;
    for (var row of t.querySelectorAll('tr')) {
      var isSunday = /sunday|रविवार/i.test(row.dataset.days || '');
      if (isSunday === sunday) row.setAttribute('data-today', '');
    }
  })();
</script>
