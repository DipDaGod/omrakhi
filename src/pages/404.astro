---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';

import { SITE } from '../config/site.ts';
import { useTranslations, DEFAULT_LOCALE } from '../i18n/ui.ts';
import { href, ROUTES } from '../lib/routes.ts';
import { whatsappHref, telHref } from '../lib/whatsapp.ts';
import { allCategories, categoryCounts } from '../lib/catalogue.ts';

/* One 404 for the site. Astro serves it for both /x and /hi/x; the strings
   below are English because that is the default locale and a lost visitor
   needs a route forward more than a translated apology. */
const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);
const [categories, counts] = await Promise.all([allCategories(), categoryCounts()]);
const biggest = [...categories]
  .sort((a, b) => (counts.get(b.id) ?? 0) - (counts.get(a.id) ?? 0))
  .slice(0, 6);
---

<Base locale={locale} noindex locales={['en']}
  title={`Page not found — ${SITE.name}`}
  description="That page does not exist. Here is the way back into the catalogue.">
  <div class="container section--tight">
    <PageHeader
      title="That page is not here"
      lede="Most links that land here are old ones from a WhatsApp thread. Everything below still works."
    />

    {/* Both filled in client-side: the first when the URL carries an article
        number, the second when it carries something that reads like a
        collection. Either one turns a dead end into the page they wanted. */}
    <div class="nf__retired" data-retired hidden></div>
    <div class="nf__guess" data-guess hidden></div>

    {/* The field is here rather than behind the header's search button: on a
        404 the next thing the visitor does is look something up, and making
        them find a control first is one step too many. Typing hands off to the
        real search overlay, so there is one search on this site, not two. */}
    <form class="nf__search" action={href(ROUTES.collections, locale)} method="get" data-nf-search>
      <label class="visually-hidden" for="nf-q">Search the catalogue</label>
      <Icon name="search" />
      <input id="nf-q" name="q" type="search" autocomplete="off" spellcheck="false"
        placeholder="Article number or design — OM-1042, kundan" />
      <button class="btn btn--primary" type="submit">Search</button>
    </form>

    <div class="nf__actions">
      <a class="btn btn--secondary" href={whatsappHref('I followed a link that no longer works')} rel="noopener">
        <Icon name="whatsapp" /> {t('action.whatsappUs')}
      </a>
      <a class="btn btn--quiet" href={telHref}><Icon name="phone" /> {SITE.phone.display}</a>
    </div>

    {/* Six, not twelve: the footer below already carries every collection, and
        printing the same twelve links twice on one short page is filler. These
        are the largest, which is the most useful order for someone who has no
        idea where to start. */}
    <h2 class="nf__h2">Biggest collections</h2>
    <ul class="nf__cats">
      {biggest.map((c) => (
        <li>
          <a href={href(ROUTES.category(c.id), locale)}>
            {c.data.name.en}
            <span>{counts.get(c.id) ?? 0}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="nf__links">
      <a href={href(ROUTES.collections, locale)}>All {categories.length} collections →</a>
      <a href={href(ROUTES.howToOrder, locale)}>{t('nav.order')}</a>
      <a href={href(ROUTES.contact, locale)}>{t('nav.contact')}</a>
    </p>
  </div>
</Base>

<script>
  import '../islands/notfound.ts';
</script>

<style>
  /* No illustration and no joke: a buyer who hit a dead link wants a route
     forward, not a cartoon. */
  .nf__retired {
    padding: var(--space-s);
    background: var(--plinth);
    border-left: 3px solid var(--accent);
    max-width: var(--measure);
    margin-bottom: var(--space-m);
  }
  .nf__guess {
    padding: var(--space-s);
    background: var(--plinth);
    border-left: 3px solid var(--gold);
    max-width: var(--measure);
    margin-bottom: var(--space-m);
  }

  .nf__search {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    max-width: 34rem;
    padding: var(--space-3xs) var(--space-3xs) var(--space-3xs) var(--space-xs);
    border: var(--hairline) solid var(--ink);
    border-radius: var(--radius);
    background: var(--ground-raised);
    margin-bottom: var(--space-s);
  }
  .nf__search:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .nf__search input { flex: 1; min-width: 0; border: 0; background: none; padding: 0.5em 0; }
  .nf__search input:focus { outline: none; }
  .nf__search svg { color: var(--ink-muted); flex: none; }

  .nf__actions { display: flex; gap: var(--space-2xs); flex-wrap: wrap; margin-bottom: var(--space-2xl); }
  .nf__h2 { font-size: var(--step-2); margin-bottom: var(--space-s); }
  .nf__cats { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3xs) var(--space-s); }
  .nf__cats a { display: flex; justify-content: space-between; gap: var(--space-s); padding: var(--space-2xs) 0; text-decoration: none; border-bottom: var(--hairline) solid var(--line); }
  .nf__cats a:hover { color: var(--accent); }
  .nf__cats span { color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .nf__links { display: flex; gap: var(--space-m); flex-wrap: wrap; margin-top: var(--space-xl); font-size: var(--step--1); }
  @media (max-width: 60rem) { .nf__cats { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 40rem) { .nf__cats { grid-template-columns: 1fr; } }
</style>
