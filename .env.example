# Copy to .env for local work, or set these in the Vercel project's
# Environment Variables. Everything here is read at build time and baked into
# the static output — there is no server to read them at runtime.

# Vercel Speed Insights. Field LCP and CLS from real visitors, which is the one
# part of the A9 budget a build cannot measure for itself.
# Enable Speed Insights in the Vercel project first, then set this to 1.
# Leaving it unset keeps the site free of any analytics, and the privacy page
# says so.
PUBLIC_SPEED_INSIGHTS=

# Vercel Web Analytics. Page views, referrers and countries — useful for
# telling whether the city pages are earning their place. Same arrangement:
# enable it in the project, then set this to 1.
PUBLIC_WEB_ANALYTICS=
