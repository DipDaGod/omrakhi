{
  "name": "omrakhi",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Om Rakhi Udyog — rakhi manufacturer and wholesale supplier, Burrabazar, Kolkata.",
  "scripts": {
    "assets": "node scripts/prepare-images.mjs && node scripts/generate-og.mjs",
    "dev": "npm run assets && astro dev",
    "build": "npm run assets && astro build && node scripts/check-budgets.mjs && node scripts/check-links.mjs",
    "build:only": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "budgets": "node scripts/check-budgets.mjs",
    "links": "node scripts/check-links.mjs",
    "smoke": "node tests/smoke.mjs",
    "test": "npm run check && npm run build && node scripts/serve-and-smoke.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.5.0",
    "fuse.js": "^7.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0"
  }
}
